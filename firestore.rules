rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------------------------------------------------------
    // METRIC SECURE RULES: ACCOUNT-BASED ZERO-KNOWLEDGE E2E
    // ------------------------------------------------------------------------

    // Public Contact Directory (Permanent Connect Codes mapped to stable account UIDs)
    match /contacts/{connectCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid', 'publicKeyBundle', 'connectCode', 'createdAt'])
        && !request.resource.data.keys().hasAny(['privateKey', 'name', 'email', 'recoveryCode', 'password']);
      allow update: if request.auth != null 
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null 
        && resource.data.ownerUid == request.auth.uid;
    }

    // 1-to-1 Encrypted Channel: Restricted strictly to the 2 account UIDs
    match /channels/{channelId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
    }

    // Encrypted Messages Subcollection
    match /channels/{channelId}/messages/{messageId} {
      // Must be authenticated with stable UID and participant in the channel
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.participants;
      
      // Enforce zero-knowledge ciphertext-only schema:
      // Absolutely NO plaintext, preview, caption, contact, or media metadata fields permitted!
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.participants
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.keys().hasAll(['senderUid', 'receiverUid', 'ciphertext', 'iv', 'ephemeralKey', 'timestamp', 'counter'])
        && !request.resource.data.keys().hasAny([
          'text', 'message', 'plaintext', 'preview', 'thumbnail', 
          'caption', 'title', 'filename', 'senderName', 'avatar'
        ]);

      // Messages can be permanently deleted by either party
      allow delete: if request.auth != null 
        && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.participants;

      // Immutability: prevent tampering with ciphertexts
      allow update: if false;
    }
  }
}
