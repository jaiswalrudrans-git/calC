rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------------------------------------------------------
    // METRIC SECURE RULES: ACCOUNT-BASED ZERO-KNOWLEDGE E2E ON FIREBASE SPARK
    // ------------------------------------------------------------------------

    // Users Directory & Profile (salted hashes & public key bundles only)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Public Connect Code Directory (6-digit numeric connect codes)
    match /connect_codes/{connectCode} {
      allow read, write: if true;
    }

    // 1-to-1 Encrypted Chats
    match /chats/{channelId} {
      allow read, write: if true;
    }

    // Encrypted Messages Subcollection
    match /chats/{channelId}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
